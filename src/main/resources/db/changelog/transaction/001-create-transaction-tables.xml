<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="t_card_holders" author="Amila">
        <comment>Create card_holders table to store customer information</comment>

        <createTable tableName="card_holders">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="phone_number" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="customer_type" type="VARCHAR(50)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="card_holders"/>
        </rollback>
    </changeSet>

    <changeSet id="s_card_holders" author="Amila">
        <comment>Create indexes on card_holders table for performance</comment>

        <createIndex indexName="idx_card_holders_email" tableName="card_holders">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_card_holders_customer_type" tableName="card_holders">
            <column name="customer_type"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_card_holders_email" tableName="card_holders"/>
            <dropIndex indexName="idx_card_holders_customer_type" tableName="card_holders"/>
        </rollback>
    </changeSet>

    <changeSet id="t_cards" author="Amila">
        <comment>Create cards table to store card issuance records</comment>

        <createTable tableName="cards">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="card_number" type="VARCHAR(16)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="holder_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="card_type" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="cards"/>
        </rollback>
    </changeSet>

    <changeSet id="s_cards" author="Amila">
        <comment>Create indexes on cards table for query performance</comment>

        <createIndex indexName="idx_cards_card_number" tableName="cards" unique="true">
            <column name="card_number"/>
        </createIndex>

        <createIndex indexName="idx_cards_status" tableName="cards">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_cards_card_type" tableName="cards">
            <column name="card_type"/>
        </createIndex>

        <createIndex indexName="idx_cards_created_at" tableName="cards">
            <column name="created_at"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_cards_card_number" tableName="cards"/>
            <dropIndex indexName="idx_cards_status" tableName="cards"/>
            <dropIndex indexName="idx_cards_card_type" tableName="cards"/>
            <dropIndex indexName="idx_cards_created_at" tableName="cards"/>
        </rollback>
    </changeSet>

    <changeSet id="c_cards" author="Amila">
        <comment>Add business rule constraints to cards table</comment>

        <sql>
            ALTER TABLE cards
                ADD CONSTRAINT chk_card_type
                    CHECK (card_type IN ('DEBIT', 'CREDIT', 'PREPAID'))
        </sql>

        <sql>
            ALTER TABLE cards
                ADD CONSTRAINT chk_card_status
                    CHECK (status IN ('ACTIVE', 'BLOCKED', 'EXPIRED', 'SUSPENDED'))
        </sql>

        <rollback>
            <sql>ALTER TABLE cards DROP CONSTRAINT chk_card_type</sql>
            <sql>ALTER TABLE cards DROP CONSTRAINT chk_card_status</sql>
        </rollback>
    </changeSet>

    <changeSet id="c_card_holders" author="Amila">
        <comment>Add business rule constraints to card_holders table</comment>

        <sql>
            ALTER TABLE card_holders
                ADD CONSTRAINT chk_customer_type
                    CHECK (customer_type IN ('RETAIL', 'CORPORATE', 'SYSTEM'))
        </sql>

        <rollback>
            <sql>ALTER TABLE card_holders DROP CONSTRAINT chk_customer_type</sql>
        </rollback>
    </changeSet>

    <changeSet id="t_transactions" author="Amila">
        <comment>Create transactions table to store financial transaction records</comment>

        <createTable tableName="transactions">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="card_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="amount" type="DECIMAL(15,2)">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_type" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="transaction_date" type="DATETIME">
                <constraints nullable="true"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="SUCCESS">
                <constraints nullable="true"/>
            </column>
            <column name="reference_number" type="VARCHAR(50)">
                <constraints nullable="true" unique="true"/>
            </column>
            <column name="merchant_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="description" type="VARCHAR(200)">
                <constraints nullable="true"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="transactions"/>
        </rollback>
    </changeSet>

    <changeSet id="c_transactions" author="Amila">
        <comment>Add foreign key constraint linking transactions to cards</comment>

        <addForeignKeyConstraint
            baseTableName="transactions"
            baseColumnNames="card_id"
            constraintName="fk_transactions_card_id"
            referencedTableName="cards"
            referencedColumnNames="id"
            onDelete="CASCADE"
            onUpdate="RESTRICT"/>

        <rollback>
            <dropForeignKeyConstraint
                baseTableName="transactions"
                constraintName="fk_transactions_card_id"/>
        </rollback>
    </changeSet>

    <changeSet id="s_transactions" author="Amila">
        <comment>Create indexes on transactions table for query optimization</comment>

        <createIndex indexName="idx_transactions_card_id" tableName="transactions">
            <column name="card_id"/>
        </createIndex>

        <createIndex indexName="idx_transactions_transaction_date" tableName="transactions">
            <column name="transaction_date" descending="true"/>
        </createIndex>

        <createIndex indexName="idx_transactions_type" tableName="transactions">
            <column name="transaction_type"/>
        </createIndex>

        <createIndex indexName="idx_transactions_status" tableName="transactions">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_transactions_reference" tableName="transactions" unique="true">
            <column name="reference_number"/>
        </createIndex>

        <createIndex indexName="idx_transactions_card_date" tableName="transactions">
            <column name="card_id"/>
            <column name="transaction_date" descending="true"/>
        </createIndex>

        <createIndex indexName="idx_transactions_type_date" tableName="transactions">
            <column name="transaction_type"/>
            <column name="transaction_date" descending="true"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_transactions_card_id" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_transaction_date" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_type" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_status" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_reference" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_card_date" tableName="transactions"/>
            <dropIndex indexName="idx_transactions_type_date" tableName="transactions"/>
        </rollback>
    </changeSet>

    <changeSet id="c_transactions_1" author="Amila">
        <comment>Add business rule constraints to transactions table</comment>

        <sql>
            ALTER TABLE transactions
                ADD CONSTRAINT chk_transaction_amount
                    CHECK (amount > 0)
        </sql>

        <sql>
            ALTER TABLE transactions
                ADD CONSTRAINT chk_transaction_type
                    CHECK (transaction_type IN ('PURCHASE', 'WITHDRAWAL', 'REFUND', 'TRANSFER'))
        </sql>

        <sql>
            ALTER TABLE transactions
                ADD CONSTRAINT chk_transaction_status
                    CHECK (status IN ('SUCCESS', 'FAILED', 'PENDING', 'REVERSED'))
        </sql>

        <rollback>
            <sql>ALTER TABLE transactions DROP CONSTRAINT chk_transaction_amount</sql>
            <sql>ALTER TABLE transactions DROP CONSTRAINT chk_transaction_type</sql>
            <sql>ALTER TABLE transactions DROP CONSTRAINT chk_transaction_status</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
