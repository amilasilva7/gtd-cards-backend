<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="t_complaints" author="Amila">
        <comment>Create complaints table to store customer complaints and issues</comment>

        <createTable tableName="complaints">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="customer_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="email" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="phone_number" type="VARCHAR(20)">
                <constraints nullable="true"/>
            </column>
            <column name="complaint_type" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="VARCHAR(20)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(20)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="DATETIME">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <rollback>
            <dropTable tableName="complaints"/>
        </rollback>
    </changeSet>

    <changeSet id="s_complaints" author="Amila">
        <comment>Create indexes on complaints table for query optimization</comment>

        <createIndex indexName="idx_complaints_status" tableName="complaints">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_complaints_priority" tableName="complaints">
            <column name="priority"/>
        </createIndex>

        <createIndex indexName="idx_complaints_complaint_type" tableName="complaints">
            <column name="complaint_type"/>
        </createIndex>

        <createIndex indexName="idx_complaints_email" tableName="complaints">
            <column name="email"/>
        </createIndex>

        <createIndex indexName="idx_complaints_created_at" tableName="complaints">
            <column name="created_at" descending="true"/>
        </createIndex>

        <createIndex indexName="idx_complaints_status_created" tableName="complaints">
            <column name="status"/>
            <column name="created_at" descending="true"/>
        </createIndex>

        <rollback>
            <dropIndex indexName="idx_complaints_status" tableName="complaints"/>
            <dropIndex indexName="idx_complaints_priority" tableName="complaints"/>
            <dropIndex indexName="idx_complaints_complaint_type" tableName="complaints"/>
            <dropIndex indexName="idx_complaints_email" tableName="complaints"/>
            <dropIndex indexName="idx_complaints_created_at" tableName="complaints"/>
            <dropIndex indexName="idx_complaints_status_created" tableName="complaints"/>
        </rollback>
    </changeSet>

    <changeSet id="c_complaints" author="Amila">
        <comment>Add business rule constraints to complaints table</comment>

        <sql>
            ALTER TABLE complaints
                ADD CONSTRAINT chk_complaint_type
                    CHECK (complaint_type IN ('PRODUCT', 'SERVICE', 'BILLING', 'OTHER'))
        </sql>

        <sql>
            ALTER TABLE complaints
                ADD CONSTRAINT chk_complaint_priority
                    CHECK (priority IN ('LOW', 'MEDIUM', 'HIGH'))
        </sql>

        <sql>
            ALTER TABLE complaints
                ADD CONSTRAINT chk_complaint_status
                    CHECK (status IN ('OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'))
        </sql>

        <rollback>
            <sql>ALTER TABLE complaints DROP CONSTRAINT chk_complaint_type</sql>
            <sql>ALTER TABLE complaints DROP CONSTRAINT chk_complaint_priority</sql>
            <sql>ALTER TABLE complaints DROP CONSTRAINT chk_complaint_status</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
